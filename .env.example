# Copy to .env and fill in before running docker-compose or k8s_deploy.sh.
# .env itself is gitignored -- never commit real values.

# MLflow tracking (local by default; override only for a remote tracking server)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Grafana admin password (used to generate the k8s Secret in k8s_deploy.sh;
# also used by docker/docker-compose.yml for the local Grafana container)
GRAFANA_ADMIN_PASSWORD=changeme
